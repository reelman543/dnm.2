addEventListener('fetch', event => {
    if (event.request.method === 'OPTIONS') {
        event.respondWith(handleOptions());
    } else {
        event.respondWith(handleRequest(event.request));
    }
});

function handleOptions() {
    return new Response(null, {
        headers: {
            'Access-Control-Allow-Origin': '*',
            'Access-Control-Allow-Methods': 'GET, HEAD, OPTIONS',
            'Access-Control-Allow-Headers': 'Range, Accept-Encoding',
            'Access-Control-Max-Age': '86400',
        }
    });
}

async function handleRequest(request) {
    const url = new URL(request.url);
    const path = url.pathname;
    
    const m3u8Match = path.match(/\/(\d+)\.m3u8$/);
    
    if (!m3u8Match) {
        return new Response('Geçersiz istek. Kullanım: /701.m3u8', { status: 400 });
    }
    
    const channelId = m3u8Match[1];
    
    try {
        const apiUrl = `https://7salamistv.online/ajax?method=channel_stream&stream=s-sport`;
        
        const clientIP = request.headers.get('CF-Connecting-IP') || 
                        request.headers.get('X-Forwarded-For') || 
                        '127.0.0.1';
        
        const apiResponse = await fetch(apiUrl, {
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                'Accept': 'application/json, text/javascript, */*; q=0.01',
                'Accept-Language': 'tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7',
                'Referer': 'https://7salamistv.online/',
                'Origin': 'https://7salamistv.online',
                'X-Requested-With': 'XMLHttpRequest',
                'X-Forwarded-For': clientIP,
                'CF-Connecting-IP': clientIP
            }
        });
        
        if (!apiResponse.ok) {
            return new Response(`Ajax hatası: ${apiResponse.status}`, { 
                status: 502,
                headers: { 'Content-Type': 'text/plain; charset=utf-8' }
            });
        }
        
        const data = await apiResponse.json();
        
        if (!data.ok || !data.stream) {
            return new Response('Yayın bulunamadı', { 
                status: 404,
                headers: { 'Content-Type': 'text/plain; charset=utf-8' }
            });
        }
        
        let streamUrl = data.stream;
        
        streamUrl = streamUrl.replace(/\/705\//, `/${channelId}/`);
        
        const streamResponse = await fetch(streamUrl, {
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
                'Referer': 'https://7salamistv.online/',
                'Accept': '*/*',
                'Accept-Language': 'tr-TR,tr;q=0.9,en-US;q=0.8,en;q=0.7',
                'X-Forwarded-For': clientIP
            }
        });
        
        if (!streamResponse.ok) {
            return new Response(`Stream hatası: ${streamResponse.status}`, { 
                status: 502,
                headers: { 'Content-Type': 'text/plain; charset=utf-8' }
            });
        }
        
        const m3u8Content = await streamResponse.text();
        
        const modifiedHeaders = new Headers({
            'Content-Type': 'application/vnd.apple.mpegurl',
            'Access-Control-Allow-Origin': '*',
            'Cache-Control': 'public, max-age=300'
        });
        
        return new Response(m3u8Content, {
            status: 200,
            headers: modifiedHeaders
        });
        
    } catch (error) {
        return new Response(`Hata: ${error.message}`, { 
            status: 500,
            headers: { 'Content-Type': 'text/plain; charset=utf-8' }
        });
    }
}
